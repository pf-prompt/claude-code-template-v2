{
  "name": "demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "reset:everything": "pnpx tsx scripts/resetEverything.ts",
    "dev": "vite",
    "check:frontend": "tsc -p ./tsconfig.react.json --noEmit",
    "build": "vite build",
    "try:backend": "pnpm runts scripts/tryBackend.ts",
    "test:backend": "pnpm runts scripts/testBackend.ts",
    "test:prototype": "pnpm lint && pnpm runts scripts/testPrototype.ts",
    "tsc:backend": "pnpm tsc --noEmit --project tsconfig.backend.json",
    "tsc:frontend": "pnpm tsc --noEmit --project tsconfig.react.json",
    "lint": "eslint . --fix",
    "preview": "vite preview",
    "try:database": "pnpm runts scripts/tryDatabase.ts",
    "drop:database": "dotenv -- tsx scripts/dropAllTables.ts",
    "deploy:database": "drizzle-kit migrate && drizzle-kit pull && pnpm lint",
    "rebuild:database": "pnpm runts scripts/dropAllTables && pnpm deploy:database",
    "runts": "tsx --env-file=.env",
    "test:frontend-smoke": "vitest run ./frontend/tests/frontendSmoke.test.ts",
    "inspect:code-structure": "pnpm runts scripts/inspectCodeStructure.ts",
    "create:snapshot": "tsx scripts/takeSnapshot.ts --tsconfig ./tsconfig.react.json"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@sentry/react": "^10.25.0",
    "@types/pg": "^8.15.6",
    "better-auth": "^1.4.5",
    "ccstate": "^5.0.0",
    "ccstate-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "echarts-for-react": "^3.0.5",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "path-to-regexp": "^8.3.0",
    "postgres": "^3.4.7",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.66.1",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@sentry/vite-plugin": "^4.6.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.30.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.3.0",
    "jsdom": "^27.2.0",
    "resize-observer-polyfill": "^1.5.1",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vitest": "^4.0.9",
    "wrangler": "^4.50.0"
  }
}
