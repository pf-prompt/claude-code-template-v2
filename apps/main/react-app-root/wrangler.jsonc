{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "demo",
    "main": "worker/index.ts",
    "compatibility_date": "2025-11-20",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true
    },
    "version_metadata": {
        "binding": "CF_VERSION_METADATA"
    }
}
